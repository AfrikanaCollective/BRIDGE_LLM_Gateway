# .env.example — copy to .env and fill in real values.
# See config.py for the app-shell settings below and gateway/config.py
# (GatewaySettings, GATEWAY_ prefix) for the gateway settings further down.
#
# Trimmed after the ITF/NAR pipeline (agents/, clients/, prompts/) was
# removed from this repo: OLLAMA_KEEP_ALIVE, REQUEST_TIMEOUT, TRACE_DIR,
# and the PROMPTS_*/DEFAULT_PROMPT_* settings that pipeline used are gone
# — config.py no longer reads them. gateway/admin/routing.yaml is now the
# only place backend URLs/keep_alive/timeouts are configured (see
# ARCHITECTURE.md §6.1/§6.5); MODEL_NAME below only sets the legacy
# /generate-with-image handler's default requested model.

# ==== App shell config (config.py) ====

MODEL_NAME=qwen3.5:9b

# API Configuration
API_HOST=0.0.0.0
API_PORT=8443
API_TITLE=Qwen LLM Gateway
API_VERSION=2.0.0

# Performance Settings: caps total concurrent generations across ALL
# tenants (protects the shared GPU backends), separate from and in
# addition to the gateway's per-tenant rate limits below.
MAX_CONCURRENT_REQUESTS=10

# Logging
LOG_LEVEL=INFO

# Image Processing
MAX_IMAGE_SIZE_MB=15
ALLOWED_IMAGE_FORMATS=JPEG,PNG,GIF,WEBP

# SSL/TLS Configuration
USE_HTTPS=True
SSL_CERT_FILE=./certs/certificate.crt
SSL_KEY_FILE=./certs/private.key
SSL_VERIFY=False

# ==== Gateway config (gateway/config.py, GatewaySettings) ====

# Redis: rate limiting + budget counters + circuit breaker state
GATEWAY_REDIS_URL=redis://localhost:6379/0

# Durable store: tenants, api keys, usage records
# SQLite for local dev (no infra needed); Postgres in docker-compose.
GATEWAY_DATABASE_URL=sqlite+aiosqlite:///./gateway.db
# GATEWAY_DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway

# Rate limiting defaults (used when a tenant policy doesn't override)
GATEWAY_DEFAULT_REQUESTS_PER_MINUTE=60
GATEWAY_DEFAULT_BURST=10

# Budgets
GATEWAY_DEFAULT_BUDGET_PERIOD=monthly

# Routing / failover — see gateway/admin/routing.yaml for the actual
# model -> backend mapping (currently: qwen3.5:9b primary @ 172.17.0.1,
# failing over to qwen3.6:35b @ 172.16.13.67 then qwen3.8:27b-q4_K_M @
# 172.18.0.1); these are just poller/breaker tuning knobs.
# Must be >= the longest chain in routing.yaml (currently 3) or the last
# backend(s) are silently never tried — see gateway/config.py.
GATEWAY_MAX_FAILOVER_ATTEMPTS=3
GATEWAY_HEALTH_CHECK_INTERVAL_SECONDS=15
GATEWAY_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
GATEWAY_CIRCUIT_BREAKER_COOLDOWN_SECONDS=30
GATEWAY_PROVIDER_REQUEST_TIMEOUT_SECONDS=600

# Images
GATEWAY_MAX_IMAGE_SIZE_MB=15

# Observability
GATEWAY_OTEL_EXPORTER_OTLP_ENDPOINT=
GATEWAY_OTEL_SERVICE_NAME=qwen-llm-gateway
GATEWAY_LOG_LEVEL=INFO

# Seed config paths
GATEWAY_ROUTING_CONFIG_PATH=gateway/admin/routing.yaml
GATEWAY_TENANTS_CONFIG_PATH=gateway/admin/tenants.yaml
